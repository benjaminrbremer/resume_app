DATABASE_URL=backend/resume_app.db
FILE_DB_ROOT=file_db
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME: set to the model tag shown in `ollama list` (e.g. qwen2.5:34b)
OLLAMA_MODEL_NAME=qwen2.5:34b
# OLLAMA_EMBED_MODEL_NAME: set to the embedding model pulled via `ollama pull` (e.g. mxbai-embed-large)
OLLAMA_EMBED_MODEL_NAME=mxbai-embed-large
